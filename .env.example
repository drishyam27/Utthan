# Utthan Platform Environment Configuration
# Copy this file to .env and add your respective API keys

# Groq API Key (High-speed Llama 3.3 / Qwen LLM inference)
# Get your free key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI API Key (Bulbul:v3 Indian Language Indic TTS)
# Get your key at: https://www.sarvam.ai/
VITE_SARVAM_API_KEY=your_sarvam_api_key_here
