# Utthan Backend Environment Configuration
# Copy this file to backend/.env and provide your actual credentials.
# NEVER commit the .env file to Git!

# Supabase Configuration
# Found in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Frontend URL for CORS (default: Vite development server)
FRONTEND_ORIGIN=http://localhost:5173

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Coordinate-to-location resolution provider
# The development adapter uses Nominatim; use an approved provider in production.
LOCATION_PROVIDER=nominatim
LOCATION_REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
LOCATION_PROVIDER_USER_AGENT=Utthan/2B location resolver
LOCATION_PROVIDER_TIMEOUT_SECONDS=8

# Sarvam AI Multilingual Speech-to-Text (STT) Configuration
# Primary provider for Indian language voice recognition
# Get your API subscription key at: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saaras:v4
